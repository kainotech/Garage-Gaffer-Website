# MOT History API (DVSA) - server-only, do NOT prefix with NEXT_PUBLIC_
# Token URL and Scope come from your DVSA credentials email/portal - they are
# specific to your registration, not a generic template.
MOT_HISTORY_TOKEN_URL=
MOT_HISTORY_SCOPE=
MOT_HISTORY_CLIENT_ID=
MOT_HISTORY_CLIENT_SECRET=
MOT_HISTORY_API_KEY=
# The host you call for the actual vehicle-lookup endpoint (different from
# the token URL above) - confirmed against the published OpenAPI spec, only
# needs setting if DVSA moves it: https://history.mot.api.gov.uk
MOT_HISTORY_API_BASE_URL=

# DVLA Vehicle Enquiry Service (VES) - server-only. Optional: used only to
# refine the vehicle-category guess (car/motorcycle/LGV/HGV/bus) via DVLA's
# official type-approval data. If left blank, the app just falls back to
# guessing the category from make+model, so this is safe to leave empty.
VES_API_KEY=
# Only needs setting if DVLA moves it: https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
VES_API_BASE_URL=
